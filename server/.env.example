# EduCore server environment variables
# Copy this file to .env for local testing. Never commit your real .env file.

NODE_ENV=development
FRONTEND_URL=http://localhost:5173
APP_NAME=EDUCORE

# SMTP2GO
# SMTP2GO supports TLS on port 2525 (recommended) and 587.
# SSL is available on port 465.
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USER=your_smtp2go_username
SMTP_PASS=your_smtp2go_password
MAIL_FROM=your_verified_sender@example.com

# Database and other existing EduCore variables go below.

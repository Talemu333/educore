# EduProw server environment variables
# Copy this file to .env for local testing. Never commit your real .env file.

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
APP_NAME=EDUPROW
DB_POOL_MAX=10

DB_HOST=your-neon-host
DB_PORT=5432
DB_NAME=your-database
DB_USER=your-database-user
DB_PASSWORD=your-database-password

# Production/staging password-reset email provider
RESEND_API_KEY=
RESEND_FROM=noreply@your-verified-domain

# Optional SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_google_app_password
MAIL_FROM=yourgmail@gmail.com

# Use a long random value in production.
SESSION_SECRET=replace-with-a-long-random-secret

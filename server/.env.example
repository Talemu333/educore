# Application
NODE_ENV=production
FRONTEND_URL=https://your-educore-frontend.vercel.app
APP_NAME=EDUCORE
PASSWORD_RESET_EXPIRY_MINUTES=30

# Resend transactional email
# Create an API key in Resend and verify the domain used by MAIL_FROM.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
MAIL_FROM=EDUCORE <noreply@your-verified-domain.com>
